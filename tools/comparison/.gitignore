# Node
node_modules/
dist/
.env
.env.local
.env.*.local
npm-debug.log*
pnpm-debug.log*

# Generated report + downloaded comparison fixtures. Scratch sweep runs
# (--max-images) land in output/sweeps/ and stay local.
output/
# Full sweep and rd-budget results are the evidence spec/EXPERIMENTS.md is
# checked against, and are committed (src/results.ts). Kept explicit so no
# broader pattern added above can swallow them.
!results/
fixtures/synthetic/
fixtures/natural/*.jpg
fixtures/natural/*.png
fixtures/holdout/*.png
fixtures/alpha/*.png
fixtures/alpha/*.jpg
fixtures/graphic/*.png
fixtures/graphic/*.jpg

# Per-version git worktrees + their build artifacts (mise run compare:versions).
.versions/
