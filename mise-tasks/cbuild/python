#!/usr/bin/env bash
#MISE description="Build the UniFFI lib, generate the ctypes bindings, stage both into the package"
#
# Stages chromahash/_uniffi.py + libchromahash_uniffi.* into python/chromahash/.
set -euo pipefail

case "$(uname)" in
  Darwin) lib=libchromahash_uniffi.dylib ;;
  *)      lib=libchromahash_uniffi.so ;;
esac

cargo build --release --manifest-path bindings/uniffi/Cargo.toml

gen="$(mktemp -d)"
( cd bindings/uniffi && cargo run --release --quiet --bin uniffi-bindgen -- \
    generate --library "target/release/$lib" --language python --out-dir "$gen" )

# uniffi-bindgen's RustBuffer builder writes a byte array one Python loop
# iteration per byte, so lowering ImageInput.rgba costs w*h*4 iterations per
# encode. Replace that loop with one ctypes.memmove for a contiguous
# one-dimensional unsigned-byte buffer (bytes, bytearray, memoryview of
# either), keeping the generated loop for anything else, so every input writes
# the same bytes or raises the same error as before. Fails the build if the
# generated loop is not found exactly once, so a uniffi upgrade that changes it
# cannot drop the patch silently.
python3 - "$gen/chromahash_uniffi.py" <<'PY'
import sys

path = sys.argv[1]
loop = """    def write(self, value):
        with self._reserve(len(value)):
            for i, byte in enumerate(value):
                self.rbuf.data[self.rbuf.len + i] = byte
"""
copy = """    def write(self, value):
        # Patched by mise-tasks/cbuild/python: one copy, not one iteration per byte.
        try:
            view = memoryview(value)
        except TypeError:
            view = None
        if view is not None and view.ndim == 1 and view.format == "B" and view.contiguous:
            n = view.nbytes
            with self._reserve(n):
                if n:
                    src = value if type(value) is bytes else view.tobytes()
                    dst = ctypes.cast(self.rbuf.data, ctypes.c_void_p).value + self.rbuf.len
                    ctypes.memmove(dst, src, n)
            return
        with self._reserve(len(value)):
            for i, byte in enumerate(value):
                self.rbuf.data[self.rbuf.len + i] = byte
"""
src = open(path, encoding="utf-8").read()
if src.count(loop) != 1:
    sys.exit(f"cbuild:python: the generated byte-array writer in {path} is not the loop this step replaces; update the patch for this uniffi-bindgen")
open(path, "w", encoding="utf-8").write(src.replace(loop, copy))
PY

cp "$gen/chromahash_uniffi.py" python/chromahash/_uniffi.py
cp "bindings/uniffi/target/release/$lib" python/chromahash/
