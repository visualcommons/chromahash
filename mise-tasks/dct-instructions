#!/usr/bin/env bash
#MISE description="Paired instruction-count ratio of the direct over the separable forward DCT at 512x512 code 1 (register D4)"
#MISE depends=["build:compare"]
#
# Usage: mise run dct-instructions [--out FILE]
#
# Counts retired user-space instructions (and cycles, reported beside them)
# per encode with perf stat, in 10 interleaved A B / B A blocks per pair,
# against the shipped default and against ACCEL_ALL, and runs the whole
# measurement twice back to back; the runs must agree within 1%. Needs
# perf with kernel.perf_event_paranoid <= 2. Writes
# tools/comparison/results/counts/dct-instructions.json
# (spec/V0.8-DECISIONS.md D4, "The speed criterion, amended").
#
# A file task rather than an inline one, because mise appends an inline task's
# arguments instead of passing them as "$@".
set -euo pipefail

cargo build --manifest-path rust/Cargo.toml --release --example encode_stdin
node tools/comparison/dist/perf/dct-instructions.js "$@"
