{
  "name": "@visualcommons/chromahash",
  "version": "0.7.2",
  "description": "Modern, high-quality image placeholder representation (LQIP) for professional photo management at scale",
  "license": "MIT OR Apache-2.0",
  "author": "Justin Chung <noreply@justinchung.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualcommons/chromahash.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/visualcommons/chromahash#readme",
  "keywords": ["image", "placeholder", "lqip", "thumbnail", "preview"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decode": {
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    },
    "./wasm": {
      "types": "./wasm/chromahash_wasm.d.ts",
      "default": "./wasm/chromahash_wasm.js"
    }
  },
  "files": ["dist", "wasm"],
  "scripts": {
    "build": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "bench": "node src/batch-bench.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "check": "biome check .",
    "check:fix": "biome check --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^25.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
